#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

export COMPOSE_PROJECT_NAME="bookcase-api-smoke"
export APP_IMAGE="bookcase-api:smoke"
export PORT="${PORT:-3097}"
export DB_PUBLISHED_PORT="${DB_PUBLISHED_PORT:-5497}"
base="http://localhost:${PORT}"
production_port="${PRODUCTION_PORT:-3096}"

cleanup() {
  docker rm --force bookcase-api-smoke-production bookcase-api-smoke-worker > /dev/null 2>&1 || true
  docker compose down --volumes --remove-orphans > /dev/null 2>&1 || true
  docker image rm bookcase-api:smoke bookcase-api:production > /dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'echo "smoke test failed" >&2; docker compose logs >&2; docker logs bookcase-api-smoke-production >&2 2> /dev/null; docker logs bookcase-api-smoke-worker >&2 2> /dev/null || true' ERR

step() { printf '%s\n' "-- $*"; }
status_of() { curl --silent --output /dev/null --write-out '%{http_code}' "$@"; }

step "docker compose up from an empty database"
docker compose up --detach --build --wait --wait-timeout 180

step "the API is ready and seeded"
curl --fail --silent "$base/health" | jq --exit-status '.status == "ok"' > /dev/null
curl --fail --silent "$base/api/v1/books" | jq --exit-status 'length == 5' > /dev/null

step "a book can be added, borrowed and returned"
[[ $(status_of -X POST "$base/api/v1/books" -H 'Content-Type: application/json' -d '{"serial_number":"900001","title":"Smoke","author":"Test"}') == 201 ]]
[[ $(status_of -X POST "$base/api/v1/books" -H 'Content-Type: application/json' -d '{"serial_number":"900001","title":"Smoke","author":"Test"}') == 409 ]]
id=$(curl --fail --silent -X POST "$base/api/v1/books/900001/borrowings" -H 'Content-Type: application/json' -d '{"card_number":"100003"}' | jq --raw-output '.id')
[[ $(status_of -X POST "$base/api/v1/books/900001/borrowings" -H 'Content-Type: application/json' -d '{"card_number":"100003"}') == 409 ]]
[[ $(status_of -X POST "$base/api/v1/borrowings/$id/return") == 200 ]]
[[ $(status_of -X POST "$base/api/v1/borrowings/$id/return") == 200 ]]
curl --fail --silent "$base/api/v1/books/900001" | jq --exit-status '.status == "available" and (.borrowings | length) == 1 and .borrowings[0].reader.email == "grace@example.com" and .borrowings[0].returned_at != null' > /dev/null
[[ $(status_of -X DELETE "$base/api/v1/books/900001") == 204 ]]
[[ $(status_of -X DELETE "$base/api/v1/books/900001") == 204 ]]
curl --fail --silent "$base/api/v1/books/900001" | jq --exit-status '.status == "withdrawn" and (.borrowings | length) == 1' > /dev/null
[[ $(status_of "$base/api/v1/books/000001/borrowings") == 404 ]]

step "the worker sends the reminder emails"
docker compose exec -T web bin/rails runner '2.times { ScheduleDueRemindersJob.perform_later }' > /dev/null
for _ in $(seq 1 30); do
  sent=$(docker compose exec -T web sh -c 'ls tmp/mails 2> /dev/null | wc -l')
  [[ "$sent" -ge 2 ]] && break
  sleep 1
done
[[ "$sent" -ge 2 ]]

step "the test suite passes inside the development image, with the coverage gate"
docker compose exec -T web sh -c 'bin/rails db:test:prepare && COVERAGE=1 bundle exec rspec' > /dev/null
docker compose exec -T web bin/rails runner 'abort "Unexpected reminder deliveries" unless Reminder.where.not(sent_at: nil).count == 2 && Dir.glob(Rails.root.join("tmp/mails/*")).sum { |path| File.read(path).scan(/^Message-ID:/i).size } == 2'

step "the web server answers its own errors in the problem format"
[[ $(curl --silent --output /dev/null --write-out '%{http_code} %{content_type}' -X FOO "$base/api/v1/books") == "501 application/problem+json" ]]

step "the production image serves the API and runs the worker"
docker build --quiet --target production --tag bookcase-api:production . > /dev/null
production_env=(
  --network "${COMPOSE_PROJECT_NAME}_default"
  -e DATABASE_URL="postgres://postgres:postgres@db/bookcase_api_production" -e SECRET_KEY_BASE=smoke
  -e APP_HOSTS=localhost -e MAILER_FROM="Library <library@example.com>" -e SMTP_ADDRESS=smtp.invalid
)
docker run --rm "${production_env[@]}" bookcase-api:production bin/rails db:prepare > /dev/null
docker run --detach --name bookcase-api-smoke-production "${production_env[@]}" \
  --publish "127.0.0.1:${production_port}:3000" bookcase-api:production > /dev/null
docker run --detach --name bookcase-api-smoke-worker "${production_env[@]}" bookcase-api:production bin/jobs > /dev/null
for _ in $(seq 1 30); do
  [[ $(docker inspect --format '{{.State.Health.Status}}' bookcase-api-smoke-production) == healthy ]] && break
  sleep 1
done
production="http://localhost:${production_port}"
curl --fail --silent "$production/health" | jq --exit-status '.status == "ok"' > /dev/null
[[ $(status_of -X POST "$production/api/v1/books" -H 'Content-Type: application/json' -d '{"serial_number":"900001","title":"Smoke","author":"Test"}') == 201 ]]
[[ $(status_of -H 'Host: attacker.example' "$production/api/v1/books") == 403 ]]
for _ in $(seq 1 30); do
  workers=$(docker run --rm "${production_env[@]}" bookcase-api:production bin/rails runner 'print SolidQueue::Process.where(kind: "Worker").count')
  [[ "$workers" -ge 1 ]] && break
  sleep 1
done
[[ "$workers" -ge 1 ]]

step "smoke test passed"
